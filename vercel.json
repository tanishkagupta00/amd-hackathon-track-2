{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/assets/:path*",
      "destination": "/frontend/dist/assets/:path*"
    },
    {
      "source": "/((?!assets/|favicon.ico).*|app)",
      "destination": "/frontend/dist/index.html"
    }
  ]
}
